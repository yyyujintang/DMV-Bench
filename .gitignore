# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/

# ---- Node / Next.js / Turbo / Vercel ----
node_modules/
.next/
.turbo/
.vercel/
out/
build/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Prisma / SQLite (databases are regenerated from seed) ----
*.db
*.db-journal
*.db.bak
*.sqlite
*.sqlite3
env/frontend/prisma/*.db*

# ---- Catalogue images (~1.5 GB each — fetch via scripts/download_images.py) ----
# Frontend-served roots and the runner-read roots all live outside git.
env/frontend/public/images_v2/
env/frontend/public/images/
data/vismem_diag_v2/images/
data/vismem_diag/

# ---- Runtime caches written by the runner (regenerated on demand) ----
data/vismem_diag_v2/f2_trajectories/
data/vismem_diag_v2/f2_trajectories_qwen/
# The 1,000 catalogue captions ARE released (364 KB) -- they are the exact
# verbal channel behind the paper's Caption and DualMem runs, and shipping
# them means reproducing the paper needs no Gemini key for captioning.
!data/vismem_diag_v2/_caption_cache.json
data/vismem_diag_v2/_caption_cache_*.json

# ---- Per-trial results / logs (written at runtime) ----
results/
exp/
logs/
slurm-*.out

# ---- Generated task pools (regenerated by tasks/generators) ----
tasks/pool_v2/

# ---- IDE / OS / editor caches ----
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/

# ---- Misc ----
*.log
*.pid
*.swp
*.bak
