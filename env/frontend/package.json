{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/sync-task-pool.mjs",
    "build": "next build",
    "prebuild": "node scripts/sync-task-pool.mjs",
    "build:vercel": "node scripts/sync-task-pool.mjs && node scripts/build-vercel.mjs && prisma generate --schema prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "prisma:postgres": "node scripts/swap-provider.mjs postgresql",
    "prisma:sqlite": "node scripts/swap-provider.mjs sqlite",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "test:watch": "vitest --pool=forks --poolOptions.forks.singleFork=true",
    "audit:ncp": "node --import tsx scripts/run-ncp-audit.ts",
    "seed:generate": "python ../scripts/generate_seed.py",
    "seed:db": "node --import tsx prisma/seed.ts",
    "seed:v2": "node --import tsx prisma/seed-v2.ts",
    "seed": "npm run seed:generate && npm run seed:db",
    "audit-leakage": "node --import tsx scripts/audit_leakage.ts",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^25.0.1",
    "playwright": "^1.60.0",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "shadcn": "^4.7.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^2.1.4"
  }
}
