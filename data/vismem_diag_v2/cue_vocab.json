    "total_categories": 10,
    "objects_per_category": 10,
    "colors": 10,
    "total_unique_cues": 1000,
    "cross_category_object_overlap": "none — each object name appears in exactly one category"
  },
  "allocation_algorithm": {
    "description": "Bijective allocation: within each category, 100 (style, prod) slots map 1:1 to 100 (object, color) cues. style_idx selects the cue_object; prod_idx within that style selects the color. Globally unique across the inventory because object_types are disjoint across categories.",
    "pseudocode": "for cat in 10 categories:\n  for style_idx in 0..9:\n    obj = cat.objects[style_idx]               # one object per style\n    for prod_idx in 0..9:\n      color = colors[prod_idx]                  # 10 colors sweep within the style\n      cue = (obj, color)                        # unique within cat, unique globally"
  }
